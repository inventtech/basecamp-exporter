# OAuth integration credentials from https://launchpad.37signals.com/integrations
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# The integration's registered Redirect URI. On Railway this is your public URL,
# e.g. https://basecamp-auth-production.up.railway.app/callback
# If unset, the service derives https://<request-host>/callback automatically.
BC_REDIRECT_URI=

# Local port (Railway sets PORT automatically).
PORT=3000
