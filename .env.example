# Basecamp account ID — the number in your Basecamp URL:
# https://3.basecamp.com/<BC_ACCOUNT_ID>/...
BC_ACCOUNT_ID=

# OAuth integration credentials, from https://launchpad.37signals.com/integrations
# Required for `bun start auth`. The integration's Redirect URI must match
# BC_REDIRECT_URI below exactly.
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# Redirect URI registered on the integration. Optional; defaults to the value
# below. MUST be a full absolute URI (scheme + host + port + path).
BC_REDIRECT_URI=http://localhost:3333/callback

# Optional manual access token. Leave blank to use the OAuth token cached by
# `bun start auth`. If set, it overrides the cached token.
BC_TOKEN=

# Optional refresh token. If set together with BC_TOKEN (and BC_CLIENT_ID/SECRET),
# the CLI auto-refreshes BC_TOKEN once it expires instead of failing.
BC_TOKEN_REFRESH=

# Basecamp REQUIRES a User-Agent that identifies your app and a contact email,
# otherwise requests are rejected.
BC_USER_AGENT=Basecamp Exporter (aran.c@invent.co.th)
